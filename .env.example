# Environment Variables

# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                          # development | staging | production
APP_SECRET_KEY=your-secret-key-here         # used for JWT signing
APP_DEBUG=true
APP_VERSION=0.1.0

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/student_roadmap
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Supabase (if using managed PostgreSQL + Auth) ─────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Primary provider: gemini | openai | anthropic
AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI (if switching provider)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Anthropic (if switching provider)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_DEFAULT_MODEL=claude-3-haiku-20240307

# ─── AI Settings ───────────────────────────────────────────────────────────────
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=30
AI_DEFAULT_TEMPERATURE=0.3
AI_MAX_TOKENS=2048
AI_COST_LOGGING_ENABLED=true

# ─── Redis (for background jobs) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=supabase                   # supabase | s3 | local
STORAGE_BUCKET=student-roadmap-uploads

# ─── Market Data Sources ───────────────────────────────────────────────────────
ONET_API_BASE_URL=https://services.onetcenter.org/ws/
ONET_USERNAME=your-onet-username
ONET_PASSWORD=your-onet-password

ESCO_API_BASE_URL=https://ec.europa.eu/esco/api

# ─── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn-here
LOG_LEVEL=INFO
LOG_FORMAT=json                             # json | text

# ─── Analytics ─────────────────────────────────────────────────────────────────
POSTHOG_API_KEY=your-posthog-key-here
POSTHOG_HOST=https://app.posthog.com

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_ROADMAP_GENERATION_PER_DAY=10
RATE_LIMIT_ASSESSMENT_PER_HOUR=20

# ─── Frontend (Next.js) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key-here
NEXT_PUBLIC_APP_ENV=development
